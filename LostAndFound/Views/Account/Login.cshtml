@model LostAndFound.Models.LoginViewModel

<h1>Login</h1>

<form method="post">

    <div class="mt-3">
        <label>Student Number</label>
        <input type="text"
               asp-for="StudentNumber"
               class="form-control" />

        <span asp-validation-for="StudentNumber"
              class="text-danger"></span>
    </div>

    <div class="mt-3">
        <label>Password</label>
        <input type="password" class="form-control" asp-for="Password" />
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" type="submit">
            Login
        </button>

        <a asp-controller="Account"
               asp-action="Guest"
               class="btn btn-secondary">
            Continue as Guest
        </a>
    </div>

</form>

<p>@ViewBag.Message</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}