@model LostAndFound.Models.AddItemViewModel

@{
    ViewData["Title"] = "Add Item";
}

<h1>Add Item</h1>

<form method="post" enctype="multipart/form-data">

    <div class="mt-3">
        <label class="form-label">Title</label>
        <input type="text" class="form-control" asp-for="Title" />
    </div>

    <div class="mt-3">
        <label class="form-label">Category</label>
        <input type="text" class="form-control" asp-for="Category" />
    </div>

    <div class="mt-3">
        <label class="form-label">Type</label>
        <select class="form-control" asp-for="Type">
            <option>Lost</option>
            <option>Found</option>
        </select>
    </div>

    <div class="mt-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" asp-for="Description"></textarea>
    </div>

    <div class="mt-3">
        <label class="form-label">Location</label>
        <input type="text" class="form-control" asp-for="Location" />
    </div>

    <div class="mt-3">
        <label class="form-label">Date</label>
        <input type="date" class="form-control" asp-for="DateLostFound" />
    </div>

    <div class="mt-3">
        <label class="form-label">Contact Name</label>
        <input type="text" class="form-control" asp-for="ContactName" />
    </div>

    <div class="mt-3">
        <label class="form-label">Contact Number</label>
        <input type="text" class="form-control" asp-for="ContactNumber" />
    </div>

    <div class="mt-3">
        <label>Upload Image</label>
        <input type="file"
               class="form-control"
               asp-for="ImageFile" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>

</form>
