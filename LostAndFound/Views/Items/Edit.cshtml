@model LostAndFound.Models.Entities.Item

<h1>Edit Item</h1>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mt-3">
        <label>Title</label>
        <input type="text" class="form-control" asp-for="Title" />
    </div>

    <div class="mt-3">
        <label>Status</label>

        <select class="form-control" asp-for="Status">
            <option>Pending</option>
            <option>Found</option>
            <option>Claimed</option>
        </select>
    </div>

    <div class="mt-3">
        <button class="btn btn-success">
            Update
        </button>
    </div>

</form>