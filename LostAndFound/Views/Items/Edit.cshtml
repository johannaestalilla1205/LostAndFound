@model LostAndFound.Models.Entities.Item

<h1>Edit Item</h1>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Category" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="Description" />
    <input type="hidden" asp-for="Location" />
    <input type="hidden" asp-for="DateLostFound" />
    <input type="hidden" asp-for="ContactName" />
    <input type="hidden" asp-for="ContactNumber" />
    <input type="hidden" asp-for="ImagePath" />

    <div class="mt-3">
        <label>Title</label>
        <input type="text" class="form-control" asp-for="Title" />
    </div>

    <div class="mt-3">
        <label class="form-label">Status</label>
        <select class="form-select" asp-for="Status">
            <option value="" disabled>Select Status ▼</option>
            <option value="Pending">Pending</option>
            <option value="Found">Found</option>
            <option value="Claimed">Claimed</option>
        </select>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            Update
        </button>
    </div>
</form>